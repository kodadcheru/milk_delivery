# Production Environment Variables for MilkDrop Express Backend
# WARNING: SECRET_KEY MUST be set to a secure, random string in production.
SECRET_KEY=your-super-secret-key-change-me
DEBUG=False
# WARNING: ALLOWED_HOSTS MUST be set to your production domain(s).
ALLOWED_HOSTS=api.yourdomain.com,127.0.0.1,localhost
DB_ENGINE=django.db.backends.postgresql
DB_NAME=milk_delivery_prod
DB_USER=milk_admin
DB_PASSWORD=milk_secure_password_2026
DB_HOST=postgres
DB_PORT=5432
CORS_ALLOWED_ORIGINS=https://milkdrop.com,https://app.milkdrop.com
CSRF_TRUSTED_ORIGINS=https://milkdrop.com,https://app.milkdrop.com

# Firebase Credentials Base64 Encoded JSON String
# Can be generated using: base64 -i firebase_credentials.json | tr -d '\n'
FIREBASE_CREDENTIALS=your-base64-encoded-credentials-string
